{
    "ls": {
        "cmd": "/bin/ls",
        "autostart": true,
        "numprocs": 2,
        "stdout": "/tmp/ls"
    },
    "tail-f": {
        "cmd": "tail -f /dev/urandom",
        "autostart": true,
        "numprocs": 1,
        "stdout": "/tmp/tail.out"
    },
    "echo": {
        "cmd": "/bin/echo 'Hello from the new entry!'",
        "autostart": false,
        "numprocs": 1,
        "stdout": "/tmp/echo.out"
    },
    "touch" : {
        "cmd": "./simple_touch.sh",
        "autostart" : false,
        "umask": "0777"
    },
    "touch_me_absolute_path" : {
        "cmd": "/home/amejia/taskmaster/simple_touch.sh",
        "autostart" : false,
        "workingdir": "/tmp"
    },
    "touch_me_relative_nodir" : {
        "cmd": "./simple_touch.sh",
        "autostart" : true,
        "workingdir": "/tmp"
    },
    "env": {
        "cmd": "./env.sh",
        "autostart" : false,
        "env": {
            "STARTED_BY": "taskmaster",
            "ANSWER": 42
        }
    }
    
}